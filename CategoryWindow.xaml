<Window x:Class="SimpleWallpaper.CategoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="300"
        SizeToContent="Height"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18">
        <TextBlock x:Name="HintText" TextWrapping="Wrap" Foreground="#6A6A6A" />

        <StackPanel x:Name="CategoryList" Margin="0,14,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="OkButton" Width="90" Padding="0,5" IsDefault="True" Click="OkButton_Click" />
            <Button x:Name="CancelButton" Width="90" Padding="0,5" Margin="10,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
