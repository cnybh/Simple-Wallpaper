<Window x:Class="SimpleWallpaper.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="300"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="12">
        <Image x:Name="LogoImage" Width="64" Height="64" HorizontalAlignment="Center" />
        <TextBlock x:Name="NameText" Margin="0,10,0,0" FontSize="16" FontWeight="SemiBold"
                   HorizontalAlignment="Center" />
        <TextBlock x:Name="VersionText" Margin="0,6,0,0" Foreground="#6A6A6A"
                   HorizontalAlignment="Center" />
        <TextBlock x:Name="HomePageText" Margin="0,6,0,0" Foreground="#6A6A6A"
                   HorizontalAlignment="Center" />

        <Button x:Name="OkButton" Margin="0,14,0,0" Width="90" Height="30" IsDefault="True" IsCancel="True"
                Click="OkButton_Click" HorizontalAlignment="Center" />
    </StackPanel>
</Window>
