<Window x:Class="SimpleWallpaper.SwitchNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <!-- No title bar of its own: the border is what gives the little box an edge to sit on. -->
    <Border BorderBrush="#FFBFBFBF" BorderThickness="1" Padding="28,16">
        <TextBlock x:Name="NoticeText" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
</Window>
